<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="custom_pos.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//ul[contains(@class, 'info-list')]" position="inside">
            <li t-if="line.fixed_discount_amount" class="info fixed-discount-amount">
                Fixed discount: <t t-esc="env.utils.formatCurrency(line.fixed_discount_amount)"/>
            </li>
        </xpath>
    </t>
</templates>
