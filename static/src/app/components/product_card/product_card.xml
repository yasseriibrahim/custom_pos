<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="custom_pos.ProductCard"
       t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-content')]" position="attributes">
            <attribute name="class" add="flex-column" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('product-name')][@t-esc='props.name']" position="after">
            <div t-if="!props.isComboPopup"
                 class="custom-pos-product-qty w-100 mt-1 small text-muted" dir="rtl">
                <span>الكمية: </span>
                <t t-esc="env.utils.formatProductQty(props.product.qty_available || 0, false)"/>
            </div>
        </xpath>
    </t>
</templates>
